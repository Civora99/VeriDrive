# ====================================================================
# PACCAR TestPilot AI - Backend Environment Configuration
# ====================================================================

# Google Gemini API Key (Required for live AI mode)
GEMINI_API_KEY=your_key_here

# Recommended Gemini Model (models/gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Demo Mode: set to true to force deterministic mock responses without calling Gemini
DEMO_MODE=false

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server configuration
HOST=0.0.0.0
PORT=8000
